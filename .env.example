# ==============================================================================
# AERO-VISION // Environment Variables Template
# ==============================================================================

# Google Gemini API Key (Required for live Gemini 2.5 multimodal vision & conversational co-pilot)
GEMINI_API_KEY="AIzaSy..."

# Server Settings
HOST="127.0.0.1"
PORT=8000
ENVIRONMENT="development"
DEBUG=true

# Production persistence on Vercel.
# Configure DATABASE_URL from a Vercel Marketplace Postgres integration
# such as Neon or Supabase. Without it, serverless deployments cannot
# persist citizen complaints across function instances/cold starts.
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Optional legacy JSON document store fallback. Prefer DATABASE_URL on Vercel.
CLOUD_DB_URL=""

# Optional Municipal Dispatch Webhook
DISPATCH_WEBHOOK_URL="https://hooks.slack.com/services/..."
