# ==============================================================================
# AERO-VISION // Environment Variables Template
# ==============================================================================

# Google Gemini API Key (Required for live Gemini 2.5 multimodal vision & conversational co-pilot)
GEMINI_API_KEY="AIzaSy..."

# Server Settings
HOST="127.0.0.1"
PORT=8000
ENVIRONMENT="development"
DEBUG=true

# Local SmartCity Vision AI Service (YOLO 5-Hazard Detection)
# Set this to enable the local multimodal vision model as the primary detector.
LOCAL_VISION_API_URL="http://127.0.0.1:8001/predict"
LOCAL_VISION_TIMEOUT_SECONDS=10

# Optional Municipal Dispatch Webhook
DISPATCH_WEBHOOK_URL="https://hooks.slack.com/services/..."
